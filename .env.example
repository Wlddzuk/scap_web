# AI Summarization APIs (fallback chain)
# OpenRouter (primary) - get from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Groq (secondary) - get from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Mistral (tertiary) - get from https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=your_mistral_api_key_here

# Gemini (fallback) - get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# FAL.ai for AI Image Generation - get from https://fal.ai/dashboard/keys
# Required for generating video B-roll images
FAL_KEY=your_fal_key_here

# AI video hook (optional, opt-in)
# When set, the 5s opening hook is rendered as a real AI video clip from FAL
# instead of 4 stills with Ken Burns zoom. Leave empty to keep the image hook.
# Falls back to image hook automatically on any failure.
# Suggested: fal-ai/ltx-video (cheap/fast), fal-ai/kling-video/v1/standard/text-to-video, fal-ai/minimax/video-01
# HOOK_VIDEO_MODEL=fal-ai/ltx-video
# HOOK_VIDEO_ASPECT=9:16

# CORS Configuration (optional)
# Comma-separated list of allowed origins for API requests
# Default: http://localhost:3000,http://localhost:5050
CORS_ORIGINS=http://localhost:3000,http://localhost:5050,https://yourdomain.com

# Database Configuration (optional)
# Default: sqlite:///path/to/instance/database.db
# DATABASE_URI=sqlite:///path/to/database.db
