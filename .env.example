# AI Summarization APIs (fallback chain: OpenRouter → Groq → Mistral → Gemini)
OPENROUTER_API_KEY=your_openrouter_api_key_here
GROQ_API_KEY=your_groq_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Text-to-speech engine and stable voices
# TTS_ENGINE: auto (Gemini then Kokoro), gemini, kokoro, or qwen3
TTS_ENGINE=auto
GEMINI_TTS_VOICE=Puck
KOKORO_VOICE=af_heart
QWEN3_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice

# FAL.ai for AI Image Generation
FAL_KEY=your_fal_key_here

# Pexels Stock Photos (optional - for "Stock Photos" image source)
PEXELS_API_KEY=your_pexels_api_key_here

# Word-synced burned-in captions (optional tuning)
# Supported models: tiny (fastest) or base (more accurate)
WHISPER_MODEL=tiny
WHISPER_CPU_THREADS=2
WHISPER_DOWNLOAD_TIMEOUT=60
CAPTION_UPPERCASE=true

# Video encoding quality (lower CRF = larger/higher quality; valid range 0-51)
VIDEO_CRF=26

# Discord Bot
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_INPUT=1477116980132843782
DISCORD_CHANNEL_PROCESSING=1477117088467390586
DISCORD_CHANNEL_OUTPUT=1477304529061019821

# Automated science story discovery (disabled until explicitly enabled)
DISCOVERY_ENABLED=false
DISCOVERY_HOUR_UTC=9
DISCOVERY_TOP_N=2

# CORS Configuration (optional)
CORS_ORIGINS=http://localhost:5050

# Database (optional - defaults to SQLite)
# DATABASE_URI=sqlite:///path/to/database.db
