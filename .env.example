# AI Summarization APIs (fallback chain: OpenRouter → Groq → Mistral → Gemini)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# The ordinary inference key reads both remaining credits and per-key usage.
# Optional override for installations that separate billing access:
# OPENROUTER_MANAGEMENT_KEY=your_openrouter_management_key_here
GROQ_API_KEY=your_groq_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Text-to-speech engine and stable voices
# TTS_ENGINE: auto (Gemini then Kokoro), gemini, kokoro, or qwen3
TTS_ENGINE=auto
GEMINI_TTS_VOICE=Puck
KOKORO_VOICE=af_heart
QWEN3_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice

# FAL.ai for AI Image Generation
FAL_KEY=your_fal_key_here
# The ordinary inference key reads the live balance from FAL's user endpoint.
# Optional billing-key override for installations that have one:
# FAL_ADMIN_BILLING_KEY=your_fal_admin_billing_key_here

# Generation-budget warning thresholds. Provider dots turn amber below the
# low threshold and red below the critical threshold.
BUDGET_LOW_USD=5
BUDGET_CRITICAL_USD=1

# Pexels Stock Photos (optional - for "Stock Photos" image source)
PEXELS_API_KEY=your_pexels_api_key_here

# AI video hook (optional, opt-in)
# When set, the 5s opening hook is rendered as a real AI video clip from FAL
# instead of 4 stills with Ken Burns zoom. Leave empty to keep the image hook.
# Falls back to image hook automatically on any failure.
# Suggested: fal-ai/ltx-video (cheap/fast), fal-ai/kling-video/v1/standard/text-to-video, fal-ai/minimax/video-01
# HOOK_VIDEO_MODEL=fal-ai/ltx-video
# HOOK_VIDEO_ASPECT=9:16
# Hard cap includes the hook plus selected body-scene motion clips.
MAX_VIDEO_CLIPS_PER_VIDEO=3
# Hard generation ceiling; publishing adds bandwidth but no generation spend.
MAX_VIDEO_ESTIMATED_COST_USD=0.60
# Used only for cost visibility in logs; adjust if the configured model changes.
VIDEO_CLIP_ESTIMATED_COST_USD=0.18
FAL_VIDEO_TIMEOUT_SECONDS=180

# Narration-safe bundled music bed. Disable for voice-only renders.
MUSIC_ENABLED=true

# Word-synced burned-in captions (optional tuning)
# Supported models: tiny (fastest) or base (more accurate)
WHISPER_MODEL=tiny
WHISPER_CPU_THREADS=2
WHISPER_DOWNLOAD_TIMEOUT=60
CAPTION_UPPERCASE=true

# Video encoding quality (lower CRF = larger/higher quality; valid range 0-51)
VIDEO_CRF=26

# Discord Bot
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_INPUT=1477116980132843782
DISCORD_CHANNEL_PROCESSING=1477117088467390586
DISCORD_CHANNEL_OUTPUT=1477304529061019821

# Automated science story discovery from the web app.
# When enabled, one Flask/Gunicorn worker runs discovery daily at this UTC hour.
# The dashboard button remains available when scheduling is disabled.
DISCOVERY_ENABLED=true
# Whole hour in UTC, 0-23.
DISCOVERY_HOUR_UTC=9
# Kept for Discord/CLI auto-processing; the web shortlist itself shows all results.
DISCOVERY_TOP_N=2
# Optional shared shortlist/lock path. Defaults to instance/discovery.json.
# DISCOVERY_STATE_PATH=/var/lib/clipper/discovery.json

# TikTok Login Kit + Content Posting API
# Register this exact static HTTPS callback in the TikTok Developer Portal.
FLASK_SECRET_KEY=replace_with_a_long_random_value
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=https://YOUR_DOMAIN/api/tiktok/oauth/callback
# Optional separate root used to encrypt OAuth tokens stored in SQLite.
# When omitted, FLASK_SECRET_KEY is used.
TIKTOK_TOKEN_ENCRYPTION_KEY=replace_with_another_long_random_value
# Reuse the same proven TokenCipher for Instagram, YouTube, and Facebook. This
# may be a separate secret; when omitted, the TikTok/Flask secret is used.
# OAUTH_TOKEN_ENCRYPTION_KEY=replace_with_a_long_random_value
# Keep false until TikTok approves/audits the Direct Post integration.
TIKTOK_ALLOW_PUBLIC_POSTS=false
# Publishing is manual-only. A finished render never starts an upload; choose
# Post on that video and explicitly select the destination(s).
# How often the server refreshes PROCESSING_UPLOAD posts from TikTok.
TIKTOK_STATUS_POLL_SECONDS=15
# Performance feedback requires the video.list and user.info.stats scopes.
# Leave scope requests off until Display API and both scopes are enabled for
# this exact app in TikTok Developer Portal. TikTok rejects the entire login
# request if any requested scope is unavailable. Posting works without them.
TIKTOK_REQUEST_METRICS_SCOPES=false
# After enabling it, existing connections use Reconnect once to grant metrics.
TIKTOK_METRICS_ENABLED=true
TIKTOK_METRICS_INTERVAL_HOURS=6
# Recent-video pages fetched per refresh (20 videos per page, maximum 20 pages).
TIKTOK_METRICS_MAX_PAGES=5
SESSION_COOKIE_SECURE=true

# Instagram Reels via the Meta Content Publishing API. The Instagram account
# must be Business/Creator and linked to a Facebook Page. Register the exact
# callback URI in the Meta app and complete App Review before non-test users.
INSTAGRAM_APP_ID=your_meta_app_id
INSTAGRAM_APP_SECRET=your_meta_app_secret
INSTAGRAM_REDIRECT_URI=https://YOUR_DOMAIN/api/instagram/oauth/callback
INSTAGRAM_GRAPH_VERSION=v23.0
INSTAGRAM_CONTAINER_TIMEOUT_SECONDS=1200

# Facebook Page Reels via the start/upload/finish API. The connecting Facebook
# user must manage the Page and grant all three listed Page permissions.
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=https://YOUR_DOMAIN/api/facebook/oauth/callback
FACEBOOK_GRAPH_VERSION=v23.0
FACEBOOK_REEL_TIMEOUT_SECONDS=1200

# YouTube Shorts via videos.insert with resumable uploads. Publish the OAuth
# consent screen to avoid seven-day test refresh-token expiry.
YOUTUBE_CLIENT_ID=your_google_oauth_client_id
YOUTUBE_CLIENT_SECRET=your_google_oauth_client_secret
YOUTUBE_REDIRECT_URI=https://YOUR_DOMAIN/api/youtube/oauth/callback

# Instagram pulls the MP4 from this public HTTPS origin. Caddy exposes only a
# signed, expiring route; the rest of Clipper remains behind Basic Auth.
PUBLIC_BASE_URL=https://YOUR_DOMAIN
PUBLIC_MEDIA_SIGNING_KEY=replace_with_a_long_random_value
PUBLIC_MEDIA_URL_TTL_SECONDS=21600

# CORS Configuration (optional)
CORS_ORIGINS=http://localhost:5050

# Database (optional - defaults to SQLite)
# DATABASE_URI=sqlite:///path/to/database.db
