[Unit]
Description=TikTok Video Generator Flask App
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/tiktok-video-gen
Environment="PATH=/var/www/tiktok-video-gen/.venv/bin"
EnvironmentFile=/var/www/tiktok-video-gen/.env
ExecStart=/var/www/tiktok-video-gen/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:5050 --timeout 300 app:app
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
